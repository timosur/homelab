{
  "api": "https://api.pangolin.timosur.com/v1",
  "organization": "timosur",
  "siteId": 1,
  "healthCheck": {
    "mode": "tcp",
    "interval": 30,
    "unhealthyInterval": 10,
    "timeout": 5,
    "healthyThreshold": 2,
    "unhealthyThreshold": 2
  },
  "routes": [
    {
      "name": "Kubernetes Portfolio",
      "domain": "timosur.com",
      "subdomain": null,
      "public": true,
      "service": {
        "namespace": "portfolio",
        "name": "portfolio",
        "port": 80
      }
    },
    {
      "name": "Kubernetes GivGroov",
      "domain": "givgroov.de",
      "subdomain": null,
      "public": true,
      "service": {
        "namespace": "givgroov",
        "name": "givgroov",
        "port": 80
      }
    },
    {
      "name": "Kubernetes Authentik",
      "domain": "timosur.com",
      "subdomain": "auth",
      "public": true,
      "service": {
        "namespace": "authentik",
        "name": "authentik-server",
        "port": 9000
      }
    },
    {
      "name": "Kubernetes Paperless",
      "domain": "timosur.com",
      "subdomain": "docs",
      "public": true,
      "service": {
        "namespace": "paperless",
        "name": "paperless",
        "port": 8000
      }
    },
    {
      "name": "Kubernetes Mealie",
      "domain": "timosur.com",
      "subdomain": "mealie",
      "public": true,
      "service": {
        "namespace": "mealie",
        "name": "mealie",
        "port": 9000
      }
    },
    {
      "name": "Kubernetes Open WebUI",
      "domain": "timosur.com",
      "subdomain": "ai",
      "public": true,
      "service": {
        "namespace": "open-webui",
        "name": "open-webui-service",
        "port": 8080
      }
    },
    {
      "name": "Kubernetes Bike Weather",
      "domain": "bike-weather.com",
      "subdomain": null,
      "public": true,
      "service": {
        "namespace": "bike-weather",
        "name": "bike-weather-nginx",
        "port": 80
      }
    },
    {
      "name": "Kubernetes Fahrrad Wetter",
      "domain": "fahrrad-wetter.com",
      "subdomain": null,
      "public": true,
      "service": {
        "namespace": "bike-weather",
        "name": "bike-weather-nginx",
        "port": 80
      }
    },
    {
      "name": "Kubernetes Bike Weather Preview",
      "domain": "preview.bike-weather.com",
      "subdomain": null,
      "public": true,
      "service": {
        "namespace": "bike-weather-preview",
        "name": "bike-weather-preview-nginx",
        "port": 80
      }
    },
    {
      "name": "Kubernetes Bike Weather Auth",
      "domain": "auth.bike-weather.com",
      "subdomain": null,
      "public": true,
      "service": {
        "namespace": "bike-weather-auth",
        "name": "bike-weather-auth-server",
        "port": 9000
      }
    }
  ]
}
